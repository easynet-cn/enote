{
  "name": "enote",
  "private": true,
  "version": "1.2.10",
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/merge-manual.mjs && vue-tsc --noEmit && vite build",
    "merge-manual": "node scripts/merge-manual.mjs",
    "preview": "vite preview",
    "format": "prettier --write src/",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "tauri": "tauri",
    "tauri:icon": "tauri icon doc/enote-icon.svg",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "^1.38.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tiptap/core": "^3.30.6",
    "@tiptap/extension-character-count": "^3.30.6",
    "@tiptap/extension-code-block-lowlight": "^3.30.6",
    "@tiptap/extension-color": "^3.30.6",
    "@tiptap/extension-font-family": "^3.30.6",
    "@tiptap/extension-highlight": "^3.30.6",
    "@tiptap/extension-image": "^3.30.6",
    "@tiptap/extension-link": "^3.30.6",
    "@tiptap/extension-mathematics": "^3.30.6",
    "@tiptap/extension-placeholder": "^3.30.6",
    "@tiptap/extension-subscript": "^3.30.6",
    "@tiptap/extension-superscript": "^3.30.6",
    "@tiptap/extension-table": "^3.30.6",
    "@tiptap/extension-table-cell": "^3.30.6",
    "@tiptap/extension-table-header": "^3.30.6",
    "@tiptap/extension-table-row": "^3.30.6",
    "@tiptap/extension-task-item": "^3.30.6",
    "@tiptap/extension-task-list": "^3.30.6",
    "@tiptap/extension-text-align": "^3.30.6",
    "@tiptap/extension-text-style": "^3.30.6",
    "@tiptap/extension-underline": "^3.30.6",
    "@tiptap/pm": "^3.30.6",
    "@tiptap/starter-kit": "^3.30.6",
    "@tiptap/vue-3": "^3.30.6",
    "@vueuse/core": "^14.4.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.14",
    "htmldiff-js": "^1.0.5",
    "jszip": "^3.10.1",
    "katex": "^0.18.5",
    "lowlight": "^3.3.0",
    "marked": "^18.0.11",
    "pinia": "^4.0.3",
    "sortablejs": "^1.15.7",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/diff-match-patch": "^1.0.36",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
